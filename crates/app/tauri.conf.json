{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "done",
  "version": "0.1.0",
  "identifier": "dev.done.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": {
      "script": "npm ci && npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "done",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDOENBRkJGRTFBMzlFN0IKUldSN25xUGh2NitNYk1GNDlYT3Q4NUs2SFRTZk1aTXFvYjhXOVVFV09sendWaUFTV3IzS1BrM0sK",
      "endpoints": [
        "https://github.com/Juliusolsson05/done/releases/latest/download/latest.json"
      ]
    }
  }
}
